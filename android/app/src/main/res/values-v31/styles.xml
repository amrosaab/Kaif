<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: plain white, no icon, so it hands over
         cleanly to the in-app Kaif splash animation. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
    <style name="NormalTheme" parent="Theme.MaterialComponents">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
